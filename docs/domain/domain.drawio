                </mxCell>
                <mxCell id="pg-lg-n-ref" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="Quando um fluxo chama outro, a caixa cita “(Atividade N)” em vez de puxar seta entre molduras. Nomes de tabela e coluna em inglês, como no backend (ex: appointment, ticket, commission_entry)." vertex="1">
                    <mxGeometry height="80" width="520" x="660" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="pg-lg-m-abas" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;" value="Abas e atividades" vertex="1">
                    <mxGeometry height="420" width="560" x="40" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="pg-lg-abas-txt" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;Macro&lt;/b&gt;: containers&lt;br&gt;&lt;b&gt;Casos de uso&lt;/b&gt;: por ator&lt;br&gt;&lt;b&gt;Fluxo de usuários&lt;/b&gt;: telas por perfil&lt;br&gt;&lt;b&gt;Layout web&lt;/b&gt;: esqueleto desktop e celular&lt;br&gt;&lt;b&gt;Autenticação&lt;/b&gt;: Atividades 1–3&lt;br&gt;&lt;b&gt;Cadastros&lt;/b&gt;: Atividades 4–10 (inclui 6a e 10a)&lt;br&gt;&lt;b&gt;Agenda&lt;/b&gt;: Atividades 11–14&lt;br&gt;&lt;b&gt;Bloqueios&lt;/b&gt;: Atividades 15–17&lt;br&gt;&lt;b&gt;Atendimento&lt;/b&gt;: Atividades 18–23&lt;br&gt;&lt;b&gt;Caixa&lt;/b&gt;: Atividades 24–27&lt;br&gt;&lt;b&gt;Comissões&lt;/b&gt;: Atividades 28–30 (inclui 29a)&lt;br&gt;&lt;b&gt;Financeiro&lt;/b&gt;: Atividades 31–32&lt;br&gt;&lt;b&gt;Tarefas&lt;/b&gt;: Atividades 33–35&lt;br&gt;&lt;b&gt;Relatórios&lt;/b&gt;: Atividades 36–37&lt;br&gt;&lt;b&gt;Auditoria&lt;/b&gt;: Registro de alterações e Atividade 38&lt;br&gt;&lt;b&gt;Scheduler&lt;/b&gt;: Jobs agendados e envio de push&lt;br&gt;&lt;b&gt;Pendências e mudanças&lt;/b&gt;: 22 itens, todos com decisão" vertex="1">
                    <mxGeometry height="370" width="520" x="60" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="pg-lg-m-req" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;" value="Requisitos" vertex="1">
                    <mxGeometry height="140" width="560" x="640" y="520" as="geometry"/>
                </mxCell>
                <mxCell id="pg-lg-req-txt" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="Os códigos RFxx, RNFxx e RNxx citados nos títulos e notas estão em &lt;b&gt;docs/requirements.md&lt;/b&gt;. Só a V1 está diagramada; itens de V2/V3 aparecem apenas nas notas." vertex="1">
                    <mxGeometry height="90" width="520" x="660" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="pg-lg-m-seed" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;" value="Dados iniciais (seed) dos domínios fixos" vertex="1">
                    <mxGeometry height="360" width="560" x="640" y="680" as="geometry"/>
                </mxCell>
                <mxCell id="pg-lg-seed-txt" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;role&lt;/b&gt;: owner (Dona), coordinator (Coordenadora), receptionist (Recepcionista), professional (Profissional), assistant (Auxiliar)&lt;br&gt;&lt;b&gt;employment_type&lt;/b&gt;: partner_mei, clt&lt;br&gt;&lt;b&gt;payment_method&lt;/b&gt;: Dinheiro, Pix, Débito, Crédito à vista, Crédito parcelado (taxas definidas pela dona)&lt;br&gt;&lt;b&gt;expense_category&lt;/b&gt;: Aluguel, Luz, Água, Produtos, Salários, Impostos, Manutenção, Marketing&lt;br&gt;&lt;b&gt;service_category&lt;/b&gt;: Cabelo, Unhas, Estética, Sobrancelha/cílios&lt;br&gt;&lt;b&gt;hair_size&lt;/b&gt;: Curto, Médio, Longo, Extra longo/muito volume&lt;br&gt;&lt;b&gt;resource&lt;/b&gt;: Sala de estética (1), Lavatório (2)&lt;br&gt;&lt;b&gt;client_source&lt;/b&gt;: Instagram, Indicação, Passagem, Outro&lt;br&gt;&lt;b&gt;appointment_status&lt;/b&gt;: scheduled, confirmed, in_service, done, canceled, no_show&lt;br&gt;&lt;b&gt;confirmation_status&lt;/b&gt;: pending, confirmed, reschedule_requested, no_answer&lt;br&gt;&lt;b&gt;time_block_status&lt;/b&gt;: pending, approved, rejected&lt;br&gt;&lt;b&gt;block_reason&lt;/b&gt;: Médico, Folga, Curso, Pessoal, Outro&lt;br&gt;&lt;b&gt;adjustment_type&lt;/b&gt;: surcharge, commercial_discount, courtesy&lt;br&gt;&lt;b&gt;cash_movement_type&lt;/b&gt;: opening, payment, refund, withdrawal, petty_expense, advance&lt;br&gt;&lt;b&gt;bill_type&lt;/b&gt;: payable, receivable&lt;br&gt;&lt;b&gt;tip_fee_policy&lt;/b&gt;: deduct, absorb (taxa sobre gorjeta)&lt;br&gt;&lt;b&gt;prep_time&lt;/b&gt;: 10 min após serviços de cabelo (configurável)" vertex="1">
                    <mxGeometry height="320" width="520" x="660" y="715" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
