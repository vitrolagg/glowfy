                <mxCell id="pg-lg-n-nota" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="Nota: regras, justificativas e propostas ainda não confirmadas." vertex="1">
