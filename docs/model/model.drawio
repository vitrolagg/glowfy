                    <mxGeometry height="50" width="395" x="3010" y="1298" as="geometry"/>
                </mxCell>
                <mxCell id="md-fi-t-appointment_item" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;appointment_item&lt;/b&gt; &lt;i&gt;&lt;font color=&#39;#555555&#39; face=&#39;Helvetica&#39;&gt;(Serviço agendado)&lt;/font&gt;&lt;/i&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt; &lt;font color=&#39;#555555&#39;&gt;serial&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;PK&lt;/font&gt;&lt;br&gt;&lt;b&gt;appointment_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → appointment.id ON DELETE CASCADE&lt;/font&gt;&lt;br&gt;&lt;b&gt;service_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → service.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;service_variation_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; &lt;font color=&#39;#999999&#39;&gt;NULL&lt;/font&gt; &lt;font color=&#39;#6c8ebf&#39;&gt;FK → service_variation.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;staff_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → staff.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;starts_at&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;timestamptz&lt;/font&gt; NOT NULL&lt;br&gt;&lt;b&gt;ends_at&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;timestamptz&lt;/font&gt; NOT NULL&lt;br&gt;&lt;b&gt;price_quoted&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;numeric(10,2)&lt;/font&gt; NOT NULL&lt;hr&gt;&lt;font color=&#39;#666666&#39;&gt;IX ix_appointment_item_staff_starts (staff_id, starts_at)&lt;/font&gt;" vertex="1">
                    <mxGeometry height="171" width="395" x="3485" y="1298" as="geometry"/>
