                <mxCell id="md-fi-t-appointment" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;appointment&lt;/b&gt; &lt;i&gt;&lt;font color=&#39;#555555&#39; face=&#39;Helvetica&#39;&gt;(Agendamento)&lt;/font&gt;&lt;/i&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt; &lt;font color=&#39;#555555&#39;&gt;serial&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;PK&lt;/font&gt;&lt;br&gt;&lt;b&gt;unit_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → unit.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;client_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → client.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;appointment_status&lt;/font&gt; NOT NULL DEFAULT &#39;scheduled&#39;&lt;br&gt;&lt;b&gt;confirmation_status&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;confirmation_status&lt;/font&gt; NOT NULL DEFAULT &#39;pending&#39;&lt;br&gt;&lt;b&gt;starts_at&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;timestamptz&lt;/font&gt; NOT NULL&lt;br&gt;&lt;b&gt;ends_at&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;timestamptz&lt;/font&gt; NOT NULL&lt;br&gt;&lt;b&gt;forced_overlap&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;boolean&lt;/font&gt; NOT NULL DEFAULT false&lt;br&gt;&lt;b&gt;overlap_confirmed_by&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; &lt;font color=&#39;#999999&#39;&gt;NULL&lt;/font&gt; &lt;font color=&#39;#6c8ebf&#39;&gt;FK → user.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;canceled_by&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; &lt;font color=&#39;#999999&#39;&gt;NULL&lt;/font&gt; &lt;font color=&#39;#6c8ebf&#39;&gt;FK → user.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;cancel_reason&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;text&lt;/font&gt; &lt;font color=&#39;#999999&#39;&gt;NULL&lt;/font&gt;&lt;br&gt;&lt;b&gt;canceled_at&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;timestamptz&lt;/font&gt; &lt;font color=&#39;#999999&#39;&gt;NULL&lt;/font&gt;&lt;br&gt;&lt;b&gt;created_by&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → user.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;created_at&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;timestamptz&lt;/font&gt; NOT NULL DEFAULT now()&lt;hr&gt;&lt;font color=&#39;#666666&#39;&gt;IX ix_appointment_unit_starts (unit_id, starts_at)&lt;/font&gt;" vertex="1">
