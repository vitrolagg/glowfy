                <mxCell id="md-fi-t-client_debt" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontFamily=Courier New;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;client_debt&lt;/b&gt; &lt;i&gt;&lt;font color=&#39;#555555&#39; face=&#39;Helvetica&#39;&gt;(Valor pendente)&lt;/font&gt;&lt;/i&gt;&lt;hr&gt;&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt; &lt;font color=&#39;#555555&#39;&gt;serial&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;PK&lt;/font&gt;&lt;br&gt;&lt;b&gt;client_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → client.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;ticket_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → ticket.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;amount&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;numeric(10,2)&lt;/font&gt; NOT NULL&lt;br&gt;&lt;b&gt;reason&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;text&lt;/font&gt; NOT NULL&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;debt_status&lt;/font&gt; NOT NULL DEFAULT &#39;open&#39;&lt;br&gt;&lt;b&gt;paid_payment_id&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; &lt;font color=&#39;#999999&#39;&gt;NULL&lt;/font&gt; &lt;font color=&#39;#6c8ebf&#39;&gt;FK → payment.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;created_by&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;integer&lt;/font&gt; NOT NULL &lt;font color=&#39;#6c8ebf&#39;&gt;FK → user.id&lt;/font&gt;&lt;br&gt;&lt;b&gt;created_at&lt;/b&gt; &lt;font color=&#39;#555555&#39;&gt;timestamptz&lt;/font&gt; NOT NULL DEFAULT now()" vertex="1">
