                <mxCell id="md-fi-notacao" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="Formato DDL (PostgreSQL): nome em negrito, tipo em cinza, NOT NULL/NULL, DEFAULT e, em azul, PK, UQ e FK → tabela.coluna. ON DELETE padrão é RESTRICT e não é escrito; só CASCADE e SET NULL aparecem. Rodapé de cada tabela: índices (IX), UNIQUE compostos/parciais (UQ) e CHECKs (CK) de mais de uma coluna.&lt;br&gt;Os tipos ENUM e as convenções do ORM estão no Módulo 7. Valores monetários em numeric(10,2) e datas com fuso em timestamptz." vertex="1">
                    <mxGeometry height="90" width="4870" x="40" y="60" as="geometry"/>
                </mxCell>
